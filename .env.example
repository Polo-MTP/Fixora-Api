# Entorno de ejecución
NODE_ENV=development
PORT=3001

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/fixoradb

# Redis (datos de tiempo real). Para levantarlo en local: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Configuración de CORS
CORS_ORIGIN=*

# Autenticación (JWT): dos secretos distintos de al menos 32 caracteres
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Correo (Resend): llave de la API y remitente verificado en Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Verificación de correo: el secreto debe tener al menos 32 caracteres
EMAIL_VERIFICATION_SECRET=
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_SECONDS=60

# Recuperación de contraseña: el secreto debe tener al menos 32 caracteres; en producción es obligatorio.
# Los códigos se guardan en Redis con expiración (10 min), así que también necesita Redis encendido.
PASSWORD_RECOVERY_SECRET=

# Almacenamiento local (tipo Laravel Storage) y enlaces firmados.
# El secreto debe tener al menos 32 caracteres; en producción es obligatorio.
STORAGE_DIR=storage
STORAGE_SIGNED_URL_SECRET=
APP_URL=http://localhost:3001


# ==========================================
# ADMINISTRADOR PRINCIPAL DE FIXORA
# ==========================================

# Correo electrónico del administrador principal.
# Debe ser una dirección válida y no estar registrada previamente.
ADMIN_PRINCIPAL_EMAIL=admin.principal@fixora.test

# Contraseña inicial del administrador principal.
# Se recomienda una contraseña segura de al menos 12 caracteres.
# Debe tener un máximo de 72 bytes por el límite de bcrypt.
ADMIN_PRINCIPAL_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA

# Nombre del administrador principal.
ADMIN_PRINCIPAL_NAME=Administrador

# Apellido paterno del administrador principal.
ADMIN_PRINCIPAL_LASTNAME_P=Principal

# Apellido materno del administrador principal (opcional).
ADMIN_PRINCIPAL_LASTNAME_M=

# Fecha de nacimiento en formato YYYY-MM-DD (opcional).
# Ejemplo: 1990-05-20
ADMIN_PRINCIPAL_BIRTH_DATE=

# Número telefónico de 10 dígitos (opcional).
ADMIN_PRINCIPAL_PHONE=